# 视频解析与云端分析（默认：i琢片 / AI Douyin）
# 注册即送 100 积分（https://top9.cc/?utm_source=github&utm_medium=env_example&utm_campaign=video-to-subtitle-summary）
# 成功解析直链扣 10 积分/次，抖音主页作品列表 5 积分/次，云端分析 10 积分/分钟
# 配置教程: docs/ai-douyin-setup.md
VIDEO_INFO_PROVIDER=ai-douyin
AI_DOUYIN_API_BASE=https://top9.cc
AI_DOUYIN_API_KEY=your_ai_douyin_api_key

# ASR 后端选择（本地转写模式生效）：faster-whisper（默认）或 volcengine
ASR_BACKEND=faster-whisper

# faster-whisper - 本地语音转写运行时参数（ASR_BACKEND=faster-whisper 时生效）
# 安装教程: docs/faster-whisper-setup.md
FW_MODEL_SIZE=small
FW_DEVICE=auto
FW_COMPUTE_TYPE=
FW_PYTHON=

# 火山引擎 VC - 云端字幕转写参数（ASR_BACKEND=volcengine 时生效）
# 安装教程: docs/bytedance-vc-setup.md
BYTEDANCE_VC_TOKEN=your_bytedance_vc_token
BYTEDANCE_VC_APPID=your_bytedance_vc_appid

# 可选（仅当 VIDEO_INFO_PROVIDER=tikhub 时使用自有 TikHub Token）
TIKHUB_TOKEN=
